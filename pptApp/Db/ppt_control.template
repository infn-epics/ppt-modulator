# bit13 (HVPS OFF, value 8192) + bit15 (Reset OFF), combined with accumulated on-bits
# HVPS OFF also cascades into Charge PFN OFF: charging the PFN without an
# HVPS is meaningless, and the auto-off sequence always turns Charge PFN
# off before HVPS, so the manual OFF button follows the same rule instead
# of leaving ChargePFN commanded on with the HVPS off underneath it.
record(aSub, "$(P):$(R):HVPS:OffCmd:Write") {
    field(DESC, "HVPS OFF -> CmdReg32")
    field(SNAM, "pptEncodeCmd32")
    field(INPA, "$(P):$(R):CmdReg:OnBits NPP")
    field(FTA,  "LONG")
    field(NOA,  "1")
    field(INPB, "40960")
    field(FTB,  "LONG")
    field(NOB,  "1")
    field(INPC, "$(P):$(R):CmdReg:HVBits NPP")
    field(FTC,  "LONG")
    field(NOC,  "1")
    field(FTVA, "LONG")
    field(NOVA, "1")
    field(OUTA, "$(P):$(R):CmdReg32 PP")
    field(FLNK, "$(P):$(R):ChargePFN:OffCmd")
}

record(longout, "$(P):$(R):ChargePFN:OffCmd") {
    field(DESC, "Charge PFN OFF")
    field(FLNK, "$(P):$(R):ChargePFN:OffCmd:ClearBit")
}
# Remember Charge PFN is now commanded OFF (clear bit6, value 64)
record(calcout, "$(P):$(R):ChargePFN:OffCmd:ClearBit") {
    field(DESC, "Charge PFN OFF")
    field(INPA, "$(P):$(R):CmdReg:OnBits NPP")
    field(CALC, "A&~64")
    field(OUT,  "$(P):$(R):CmdReg:OnBits PP")
    field(OOPT, "Every Time")
    field(FLNK, "$(P):$(R):ChargePFN:OffCmd:Write")
}
# bit14 (Charge PFN OFF, value 16384) + bit15 (Reset OFF), combined with accumulated on-bits
record(aSub, "$(P):$(R):ChargePFN:OffCmd:Write") {
    field(DESC, "Charge PFN OFF -> CmdReg32")
    field(SNAM, "pptEncodeCmd32")
    field(INPA, "$(P):$(R):CmdReg:OnBits NPP")
    field(FTA,  "LONG")
    field(NOA,  "1")
    field(INPB, "49152")
    field(FTB,  "LONG")
    field(NOB,  "1")
    field(INPC, "$(P):$(R):CmdReg:HVBits NPP")
    field(FTC,  "LONG")
    field(NOC,  "1")
    field(FTVA, "LONG")
    field(NOVA, "1")
    field(OUTA, "$(P):$(R):CmdReg32 PP")
}


# ==========================================================================
# HVPS CHARGING VOLTAGE SETPOINT (bytes 2-3 in 32-bit register)
# ==========================================================================
# Value range: 0..500 (0..50.0 kV)
# HVMAX macro limits operational voltage (default: 37 kV)
# Example: 37 kV = value 370 in raw units

# User-facing voltage setpoint (in kV display units)
record(ao, "$(P):$(R):HVPS:VoltageSet") {
    field(DESC, "HVPS Charging Voltage SP")
    field(EGU,  "kV")
    field(PREC, "1")
    field(HOPR, "$(HVMAX=37)")
    field(LOPR, "0")
    field(DRVH, "$(HVMAX=37)")
    field(DRVL, "0")
    field(VAL,  "0")
    field(FLNK, "$(P):$(R):HVPS:VoltageCalc")
    info(autosaveFields, "VAL")
}

# Convert kV to raw units (x10) and clamp to HVMAX
record(calcout, "$(P):$(R):HVPS:VoltageCalc") {
    field(DESC, "Convert kV to raw units")
    field(INPA, "$(P):$(R):HVPS:VoltageSet")
    field(INPB, "$(HVMAX=37)")
    field(CALC, "MIN(A,B)*10")
    field(OUT,  "$(P):$(R):CmdReg:HVBits PP")
    field(OOPT, "Every Time")
    field(FLNK, "$(P):$(R):CalcFullCmd32FromHV")
}

# Trigger full 32-bit write when HV changes
# bit15 (Reset OFF) + accumulated on-bits -- pure HV update, carries forward
# whichever subsystems are currently commanded ON
record(aSub, "$(P):$(R):CalcFullCmd32FromHV") {
    field(DESC, "HV update -> CmdReg32")
    field(SNAM, "pptEncodeCmd32")
    field(INPA, "$(P):$(R):CmdReg:OnBits NPP")
    field(FTA,  "LONG")
    field(NOA,  "1")
    field(INPB, "32768")
    field(FTB,  "LONG")
    field(NOB,  "1")
    field(INPC, "$(P):$(R):CmdReg:HVBits NPP")
    field(FTC,  "LONG")
    field(NOC,  "1")
    field(FTVA, "LONG")
    field(NOVA, "1")
    field(OUTA, "$(P):$(R):CmdReg32 PP")
}

# Maximum operational voltage display
record(ai, "$(P):$(R):HVPS:VoltageMax") {
    field(DESC, "HVPS Maximum Voltage")
    field(VAL,  "$(HVMAX=37)")
    field(EGU,  "kV")
    field(PREC, "1")
    field(PINI, "YES")
}

# Readback for confirmation (from device read)
record(ai, "$(P):$(R):HVPS:VoltageSet:RBV") {
    field(DESC, "HVPS Voltage SP Readback")
    field(INP,  "$(P):$(R):HVPS:VoltageSet")
    field(EGU,  "kV")
    field(PREC, "1")
    field(HOPR, "$(HVMAX=37)")
    field(LOPR, "0")
}

# ==========================================================================
# SIMPLIFIED CONTROL RECORDS (High-Level Commands)
# ==========================================================================
# These provide simple ON/OFF control for each subsystem

record(bo, "$(P):$(R):Thy:Control") {
    field(DESC, "Thyratron Control")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(OUT,  "$(P):$(R):Thy:ControlFanout.PROC PP")
}

record(fanout, "$(P):$(R):Thy:ControlFanout") {
    field(LNK1, "$(P):$(R):Thy:ControlCalc")
}

record(calcout, "$(P):$(R):Thy:ControlCalc") {
    field(INPA, "$(P):$(R):Thy:Control")
    field(CALC, "A")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(OUT,  "$(P):$(R):Thy:OnCmd PP")    # If 1, trigger ON
    field(FLNK, "$(P):$(R):Thy:ControlCalc2")
}

record(calcout, "$(P):$(R):Thy:ControlCalc2") {
    field(INPA, "$(P):$(R):Thy:Control")
    field(CALC, "!A")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(OUT,  "$(P):$(R):Thy:OffCmd PP")   # If 0, trigger OFF
}

# Similar pattern for other subsystems (Klystron, Focus, Premag, HVPS, ChargePFN)
# Can be expanded as needed
