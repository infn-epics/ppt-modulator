# ==========================================================================
# INDIVIDUAL ON COMMAND RECORDS (set bits 0-7)
# ==========================================================================
# Each ON command first ORs its bit into CmdReg:OnBits (remembering that
# this subsystem is now on), then writes the full register (accumulated
# on-bits + bit15 Reset-OFF + current HV).

record(longout, "$(P):$(R):Thy:OnCmd") {
    field(DESC, "Thyratron Heater ON")
    field(FLNK, "$(P):$(R):Thy:OnCmd:SetBit")
}
# Remember Thyratron Heater is now commanded ON (bit0, value 1)
record(calcout, "$(P):$(R):Thy:OnCmd:SetBit") {
    field(DESC, "Thyratron Heater ON")
    field(INPA, "$(P):$(R):CmdReg:OnBits NPP")
    field(CALC, "A|1")
    field(OUT,  "$(P):$(R):CmdReg:OnBits PP")
    field(OOPT, "Every Time")
    field(FLNK, "$(P):$(R):Thy:OnCmd:Write")
}
# bit15 (Reset OFF) combined with accumulated on-bits
record(aSub, "$(P):$(R):Thy:OnCmd:Write") {
    field(DESC, "Thyratron Heater ON -> CmdReg32")
    field(SNAM, "pptEncodeCmd32")
    field(INPA, "$(P):$(R):CmdReg:OnBits NPP")
    field(FTA,  "LONG")
    field(NOA,  "1")
    field(INPB, "32768")
    field(FTB,  "LONG")
    field(NOB,  "1")
    field(INPC, "$(P):$(R):CmdReg:HVBits NPP")
    field(FTC,  "LONG")
    field(NOC,  "1")
    field(FTVA, "LONG")
    field(NOVA, "1")
    field(OUTA, "$(P):$(R):CmdReg32 PP")
}

